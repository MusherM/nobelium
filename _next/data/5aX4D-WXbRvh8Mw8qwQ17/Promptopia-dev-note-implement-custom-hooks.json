[" 。"]]},"content":["82ff866f-2504-49e3-bbc5-da03f6bad0bf"],"created_time":1720767409935,"last_edited_time":1720767597703,"parent_id":"aad73222-ad1a-482f-a6bb-0e9967ecc75f","parent_table":"block","alive":true,"created_by_table":"notion_user","created_by_id":"4e783237-cc83-440e-9604-bac369009c55","last_edited_by_table":"notion_user","last_edited_by_id":"4e783237-cc83-440e-9604-bac369009c55","space_id":"01ff42de-5b53-40d7-a69e-999e3574e640"},"role":"reader"},"82ff866f-2504-49e3-bbc5-da03f6bad0bf":{"value":{"id":"82ff866f-2504-49e3-bbc5-da03f6bad0bf","version":34,"type":"code","properties":{"title":[["useEffect(() => {\n    fetchPosts()\n  }, [])"]],"language":[["JavaScript"]]},"created_time":1720767596759,"last_edited_time":1720767604720,"parent_id":"0d1717be-d74f-40b1-a76f-f19a0d11d9aa","parent_table":"block","alive":true,"created_by_table":"notion_user","created_by_id":"4e783237-cc83-440e-9604-bac369009c55","last_edited_by_table":"notion_user","last_edited_by_id":"4e783237-cc83-440e-9604-bac369009c55","space_id":"01ff42de-5b53-40d7-a69e-999e3574e640"},"role":"reader"},"be0b7750-17a2-4c89-b129-8926e5f7d704":{"value":{"id":"be0b7750-17a2-4c89-b129-8926e5f7d704","version":187,"type":"numbered_list","properties":{"title":[["我们需要对输入内容具有响应性，这实际上是一个“防抖”功能的实现"]]},"created_time":1720767654747,"last_edited_time":1720767677423,"parent_id":"aad73222-ad1a-482f-a6bb-0e9967ecc75f","parent_table":"block","alive":true,"created_by_table":"notion_user","created_by_id":"4e783237-cc83-440e-9604-bac369009c55","last_edited_by_table":"notion_user","last_edited_by_id":"4e783237-cc83-440e-9604-bac369009c55","space_id":"01ff42de-5b53-40d7-a69e-999e3574e640"},"role":"reader"},"1bc2cee1-58ba-47b4-a089-3ed5d864ef5b":{"value":{"id":"1bc2cee1-58ba-47b4-a089-3ed5d864ef5b","version":49,"type":"sub_sub_header","properties":{"title":[["实现自定义Hook"]]},"created_time":1720767586256,"last_edited_time":1720767613891,"parent_id":"aad73222-ad1a-482f-a6bb-0e9967ecc75f","parent_table":"block","alive":true,"created_by_table":"notion_user","created_by_id":"4e783237-cc83-440e-9604-bac369009c55","last_edited_by_table":"notion_user","last_edited_by_id":"4e783237-cc83-440e-9604-bac369009c55","space_id":"01ff42de-5b53-40d7-a69e-999e3574e640"},"role":"reader"},"6317d16d-9b02-4c61-8f92-dc92efc00e2c":{"value":{"id":"6317d16d-9b02-4c61-8f92-dc92efc00e2c","version":229,"type":"text","properties":{"title":[["当分析清楚了需求是什么之后，代码实现起来就没什么难度了。"]]},"created_time":1720767631147,"last_edited_time":1720767777912,"parent_id":"aad73222-ad1a-482f-a6bb-0e9967ecc75f","parent_table":"block","alive":true,"created_by_table":"notion_user","created_by_id":"4e783237-cc83-440e-9604-bac369009c55","last_edited_by_table":"notion_user","last_edited_by_id":"4e783237-cc83-440e-9604-bac369009c55","space_id":"01ff42de-5b53-40d7-a69e-999e3574e640"},"role":"reader"},"de76d38a-e3eb-46e0-abaa-0a00b9881023":{"value":{"id":"de76d38a-e3eb-46e0-abaa-0a00b9881023","version":782,"type":"text","properties":{"title":[["写这段防抖和tag点击逻辑的时候有点小插曲，就是防抖需要对输入框生效，但不应该对tag的点击生效，毕竟没人希望点击tag后需要等1s才能有相应，这就涉及一些清楚定时器的操作，这其中遇到的一些异步逻辑的debug过程，已经在上一篇博文中介绍了，有兴趣可以查看这篇文章："],["‣",[["lm",{"href":"https://musherm.github.io/nobelium/Promptopia-dev-note-state-ref-and-async","title":"Promptopia 开发笔记（2）——useState、useRef与异步逻辑","icon_url":"https://musherm.github.io/nobelium/apple-touch-icon.png","description":"从一次 debug 经历出发，讲讲 JS 里的异步机制如何影响你的代码执行？","link_author":"Musher","thumbnail_url":"https://og-image-craigary.vercel.app/Promptopia%20%E5%BC%80%E5%8F%91%E7%AC%94%E8%AE%B0%EF%BC%882%EF%BC%89%E2%80%94%E2%80%94useState%E3%80%81useRef%E4%B8%8E%E5%BC%82%E6%AD%A5%E9%80%BB%E8%BE%91.png?theme=dark&md=1&fontSize=125px&images=https%3A%2F%2Fnobelium.vercel.app%2Flogo-for-dark-bg.svg"}]]]]},"created_time":1720767778194,"last_edited_time":1720767876649,"parent_id":"aad73222-ad1a-482f-a6bb-0e9967ecc75f","parent_table":"block","alive":true,"created_by_table":"notion_user","created_by_id":"4e783237-cc83-440e-9604-bac369009c55","last_edited_by_table":"notion_user","last_edited_by_id":"4e783237-cc83-440e-9604-bac369009c55","space_id":"01ff42de-5b53-40d7-a69e-999e3574e640"},"role":"reader"},"535953ad-9aac-4446-8913-489110357ae6":{"value":{"id":"535953ad-9aac-4446-8913-489110357ae6","version":29,"type":"code","properties":{"title":[["import { useState, useEffect, useRef } from 'react'\n\nconst useSearchPosts = (initialSearchText = '') => {\n  const [searchText, setSearchText] = useState(initialSearchText)\n  const [posts, setPosts] = useState([])\n  const timeoutId = useRef(null)\n\n  // 获取所有 prompt\n  const fetchPosts = async () => {\n    const response = await fetch('/api/prompt')\n    const data = await response.json()\n    setPosts(data)\n  }\n\n  // 根据搜索关键词获取 prompt\n  const fetchSearchPosts = async search => {\n    const response = await fetch('/api/prompt/search?searchText=' + search)\n    const data = await response.json()\n    setPosts(data)\n  }\n\n  useEffect(() => {\n    fetchPosts()\n  }, [])\n\n  // 防抖\n  useEffect(() => {\n    if (searchText.trim()) {\n      const newTimeout = setTimeout(() => {\n        fetchSearchPosts(searchText)\n      }, 1000)\n      timeoutId.current = newTimeout\n      console.log('set!', newTimeout)\n      return () => clearTimeout(newTimeout)\n    } else {\n      fetchPosts()\n      return () => clearTimeout(timeoutId.current)\n    }\n  }, [searchText])\n\n  const handleSearchChange = e => {\n    setSearchText(e.target.value)\n  }\n\n  const handleSubmit = e => {\n    e.preventDefault()\n    console.log('clear by submit', timeoutId.current)\n    clearTimeout(timeoutId.current)\n    fetchSearchPosts(searchText)\n  }\n\n  const handleTagClick = tag => {\n    setSearchText(tag)\n    // 需要等待searchText更新完毕，再清除副作用带来的定时器\n    setTimeout(() => {\n      console.log('clear by tag', timeoutId.current)\n      clearTimeout(timeoutId.current)\n    }, 0)\n    fetchSearchPosts(tag) // 立即执行搜索\n  }\n\n  return {\n    searchText,\n    posts,\n    fetchPosts,\n    handleSearchChange,\n    handleSubmit,\n    handleTagClick\n  }\n}\n\nexport default useSearchPosts\n"]],"language":[["JavaScript"]]},"created_time":1720767626193,"last_edited_time":1720767629620,"parent_id":"aad73222-ad1a-482f-a6bb-0e9967ecc75f","parent_table":"block","alive":true,"created_by_table":"notion_user","created_by_id":"4e783237-cc83-440e-9604-bac369009c55","last_edited_by_table":"notion_user","last_edited_by_id":"4e783237-cc83-440e-9604-bac369009c55","space_id":"01ff42de-5b53-40d7-a69e-999e3574e640"},"role":"reader"}},"collection":{"4126d965-c550-46af-bc34-c038f0103084":{"value":{"id":"4126d965-c550-46af-bc34-c038f0103084","version":14,"name":[["NOBELIUM Template"]],"schema":{"NX\\Q":{"name":"date","type":"date","description":""},"`gQ~":{"name":"type","type":"select","options":[{"id":"5aff2f95-fd1e-489b-8840-bf10bc9519cb","color":"purple","value":"Post"},{"id":"374d2bc6-a144-4832-8ca4-474aaae0ea1f","color":"orange","value":"Page"}]},"d]hq":{"name":"slug","type":"text"},"sD^m":{"name":"tags","type":"multi_select","options":[{"id":"2382b30f-9881-4a8b-ae7f-2d34979c4fb9","color":"pink","value":"Website"},{"id":"38611f8e-ab81-4a71-8d40-7bad1370b26a","color":"orange","value":"TEMP"},{"id":"a3d8eb51-77ce-4e83-a9ae-68da9cee63fa","color":"default","value":"Design"},{"id":"87df7c95-06f0-477a-a530-14be415a1dcf","color":"gray","value":"React"},{"id":"76cb8fea-49e8-47c1-a982-b3a8a23d2278","color":"green","value":"Next.js"},{"id":"63e95905-41f5-4027-8bd4-330129476432","color":"brown","value":"TODO"},{"id":"6dbab06e-0532-484d-9c94-9be429b2abf8","color":"red","value":"Nobelium"},{"id":"a7dda041-f452-423c-b00f-dbe7402400ca","color":"pink","value":"JavaScript"},{"id":"342137b7-8f91-4075-8b7c-a2b1ce4dd57a","color":"purple","value":"Leetcode"},{"id":"f5d67203-b2fb-48bf-9b44-9ede058cabef","color":"blue","value":"Hooks"}]},"wz|S":{"name":"summary","type":"text"},"title":{"name":"title","type":"title"},"f211bdc0-ee00-4186-9a7d-f68c055ec2ee":{"name":"status","type":"select","options":[{"id":"22460321-fea2-4c7c-b352-a674760780ac